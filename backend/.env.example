# Genera una chiave sicura con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True solo in locale, False in produzione
DEBUG=False

# Database Postgres (Neon). Vuota in locale = SQLite in db.sqlite3.
# In produzione è obbligatoria: su Vercel il disco si azzera.
DATABASE_URL=

# Hosts accettati oltre a localhost. Su Vercel i domini del progetto si aggiungono da soli.
ALLOWED_HOSTS=localhost,127.0.0.1

# URL completo del frontend (senza slash finale), es. https://dinomoldo-dev.vercel.app
# Viene aggiunto a CORS_ALLOWED_ORIGINS e CSRF_TRUSTED_ORIGINS
FRONTEND_URL=

# API key Resend per l'invio email (https://resend.com)
RESEND_API_KEY=

# Email destinatario delle notifiche di contatto
CONTACT_NOTIFICATION_EMAIL=
