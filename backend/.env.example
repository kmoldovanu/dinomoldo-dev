# Genera una chiave sicura con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True solo in locale, False in produzione
DEBUG=False

# Hosts accettati dal backend, separati da virgola
# In sviluppo: localhost,127.0.0.1
# In produzione Railway: aggiungere il dominio railway, es:
#   localhost,127.0.0.1,dinomoldo-backend.up.railway.app
ALLOWED_HOSTS=localhost,127.0.0.1

# URL completo del frontend Vercel (senza slash finale)
# Es: https://dinomoldo-dev.vercel.app  oppure  https://dinomoldo.dev
# Viene aggiunto automaticamente a CORS_ALLOWED_ORIGINS e CSRF_TRUSTED_ORIGINS
FRONTEND_URL=

# API key Resend per l'invio email (https://resend.com)
# Usata al posto di SMTP perché Railway free tier blocca la porta 587
RESEND_API_KEY=

# Email destinatario delle notifiche di contatto
CONTACT_NOTIFICATION_EMAIL=

# Variabili SMTP (non usate con Resend, mantenute per compatibilità)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
